{
  "name": "@kvvasuu/klipp",
  "version": "0.11.0",
  "description": "Declarative virtual camera library for react-three-fiber, inspired by Unity Cinemachine.",
  "keywords": [
    "react-three-fiber",
    "r3f",
    "three.js",
    "camera",
    "virtual-camera",
    "cinemachine",
    "webgl"
  ],
  "license": "MIT",
  "author": "Łukasz Kwas (https://github.com/kvvasuu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvvasuu/klipp.git"
  },
  "homepage": "https://github.com/kvvasuu/klipp#readme",
  "bugs": {
    "url": "https://github.com/kvvasuu/klipp/issues"
  },
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./three/camera-controls": {
      "types": "./dist/three/body/CameraControlsBody.d.ts",
      "default": "./dist/three/body/CameraControlsBody.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/camera-controls": {
      "types": "./dist/react/body/camera-controls.d.ts",
      "default": "./dist/react/body/camera-controls.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bench": "labs",
    "bench:alloc": "tsx --single-threaded test/allocations.ts",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.7.0",
    "camera-controls": "^3.1.2",
    "react": ">=19.2.0",
    "three": ">=0.156.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "camera-controls": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pmndrs/labs": "^0.9.0",
    "@react-three/fiber": "^9.7.0",
    "@react-three/test-renderer": "^9.1.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "camera-controls": "^3.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "math": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yml,yaml,md,css,html}": "prettier --write"
  }
}
